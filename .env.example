# Port where the Express server listens
PORT=8000

# Title shown in the Node-RED editor
NODE_RED_TITLE=Node-RED Cloud

# Admin user credentials
NODE_RED_ADMIN_USER=admin
# bcrypt hash of the password (NOT the plain password).
# Generate it with:  node -e "console.log(require('bcryptjs').hashSync('yourpassword', 8))"
NODE_RED_ADMIN_HASH=$2b$08$oBDP7IEH023NEvJpcd/d6e4mx/l8HXeFfymsilD7Ob8yX8hWG/yuK

# Node-RED user directory (flows, credentials, lib).
# Kept only for node_modules and runtime scratch files: all persistent state
# is stored in the database by the Sequelize storage plugin.
NODE_RED_USER_DIR=

# Route prefixes
NODE_RED_ADMIN_ROOT=/admin
NODE_RED_NODE_ROOT=/

# Link opened when clicking the header logo
NODE_RED_HEADER_URL=https://nodered.org

# ---------------------------------------------------------------------------
# node-red-storage-sequelize
#
# One package handles BOTH persistence concerns:
#   - the storage module  (flows, credentials, settings, sessions, library)
#   - the context store   (global / flow / node variables)
#
# DEFAULTS: NODE_RED_STORAGE_DIALECT controls everything. If it is not set,
# Node-RED keeps using its own filesystem storage and context stays in memory,
# exactly like a stock installation. Uncomment the dialect to move BOTH into
# a database.
# ---------------------------------------------------------------------------

# Dialect: postgres | mysql | mariadb | mssql | sqlite
#   <- uncomment to persist flows AND context in a database
# NODE_RED_STORAGE_DIALECT=postgres

# Connection. Alternatively use a single URL:
# NODE_RED_STORAGE_URL=postgres://nodered:secret@localhost:5432/nodered
NODE_RED_STORAGE_HOST=localhost
NODE_RED_STORAGE_PORT=5432
NODE_RED_STORAGE_DATABASE=nodered
NODE_RED_STORAGE_USERNAME=nodered
NODE_RED_STORAGE_PASSWORD=secret

# Optional tuning
NODE_RED_STORAGE_SCHEMA=
NODE_RED_STORAGE_SSL=false
NODE_RED_STORAGE_SSL_REJECT_UNAUTHORIZED=true
NODE_RED_STORAGE_POOL_MAX=5
NODE_RED_STORAGE_LOGGING=false

# Context batching. 0 (default) writes immediately, so a value is visible to
# every node, instance and external tool as soon as it is set. Raise it to
# batch writes at the cost of losing up to N seconds on a crash.
NODE_RED_STORAGE_FLUSH_INTERVAL=0
# How long a read may be served from memory before re-checking the database.
# 0 (default) always reads the database, so external changes are seen at once.
NODE_RED_STORAGE_CACHE_TTL=0
