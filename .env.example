# ==========================================================================
# Configuracion de node-red-express (Express + Node-RED + Docker/Render)
#
# Copia este archivo a `.env` y rellena los valores.
# NO subas `.env` al repositorio: contiene la contrasena de la base de datos.
# ==========================================================================

# --------------------------------------------------------------------------
# Servidor
# --------------------------------------------------------------------------
# Puerto de escucha. Render lo inyecta automaticamente; si se define aqui se
# respeta la variable de entorno del contenedor por encima de este valor.
PORT=8000

# Interfaz de escucha. 0.0.0.0 es obligatorio dentro de un contenedor.
HOST=0.0.0.0

# Zona horaria usada por los nodos (Date, cron, ...).
TZ=UTC

# --------------------------------------------------------------------------
# Editor
# --------------------------------------------------------------------------
# Titulo mostrado en la pestana del navegador y en la cabecera del editor.
NODE_RED_TITLE=Node-RED Cloud

# Rutas del editor y de los nodos HTTP.
NODE_RED_ADMIN_ROOT=/admin
NODE_RED_NODE_ROOT=/

# Enlace que se abre al pulsar el logo de la cabecera.
NODE_RED_HEADER_URL=https://nodered.org

# Carpeta con las imagenes del editor: favicon.ico, logo.png y cover.png.
# Si se deja vacio se usa ./assets. En Docker puede apuntar a un volumen para
# personalizar la marca sin reconstruir la imagen, por ejemplo /data/assets.
# Si un archivo no existe, Node-RED usa la imagen que trae por defecto.
NODE_RED_ASSETS_DIR=

# Directorio de trabajo (userDir) de Node-RED. Con un dialecto configurado los
# flujos y las credenciales viven en la base de datos, asi que aqui solo se
# guardan archivos temporales de ejecucion. En Docker: /data
NODE_RED_USER_DIR=

# Detras del proxy de Render la peticion llega con cabeceras X-Forwarded-*.
# Sin esto Node-RED cree que sirve HTTP plano y construye mal las URLs del
# editor y del WebSocket. Ponlo a "false" solo si expones el puerto directo.
NODE_RED_TRUST_PROXY=true

# --------------------------------------------------------------------------
# Autenticacion del editor
# --------------------------------------------------------------------------
NODE_RED_ADMIN_USER=admin

# Hash bcrypt de la contrasena (NUNCA la contrasena en claro).
# Genera uno con:
#   node -e "console.log(require('bcryptjs').hashSync('tu-password', 8))"
# o con la imagen oficial:
#   docker run --rm --entrypoint npx nodered/node-red node-red admin hash-pw
# IMPORTANTE: en un .env usa comillas simples para que no se expanda el '$'.
NODE_RED_ADMIN_HASH='$2b$08$REEMPLAZA_ESTE_VALOR_POR_TU_HASH_BCRYPT'

# Semilla con la que Node-RED cifra las credenciales de los flujos.
# Si se deja vacio, Node-RED genera una y la guarda en la base de datos (vale
# para una sola instancia). Con varias replicas, o al migrar de base de datos,
# todas deben compartir la misma semilla o las credenciales no se podran
# descifrar.
NODE_RED_CREDENTIAL_SECRET=

# Nivel de log en consola: error | warn | info | debug | trace
NODE_RED_LOG_LEVEL=info

# --------------------------------------------------------------------------
# Persistencia: node-red-storage-sequelize
#
# Un solo paquete gestiona AMBAS cosas:
#   - el modulo de storage (flows, credenciales, settings, sesiones, libreria)
#   - el almacen de contexto (variables global / flow / node)
#
# Una sola variable las controla: NODE_RED_STORAGE_DIALECT. Si NO se define,
# Node-RED usa su almacenamiento en ficheros y el contexto en memoria, igual
# que una instalacion estandar. Controladores incluidos en el proyecto:
# pg + pg-hstore (postgres) y mysql2 (mysql).
# --------------------------------------------------------------------------

# Dialecto: postgres | mysql | mariadb | mssql | sqlite
# Dejalo vacio o comentado para no usar base de datos.
NODE_RED_STORAGE_DIALECT=postgres

# --- Opcion A: una sola cadena de conexion (recomendado en la nube) --------
# Si se define, tiene prioridad sobre las variables sueltas de abajo.
# Postgres gestionado suele exigir TLS: anade ?sslmode=require
#   postgresql://usuario:password@host:5432/nodered?sslmode=require
NODE_RED_STORAGE_URL=

# --- Opcion B: variables sueltas -------------------------------------------
NODE_RED_STORAGE_HOST=localhost
NODE_RED_STORAGE_PORT=5432
NODE_RED_STORAGE_DATABASE=nodered
NODE_RED_STORAGE_USERNAME=postgres
NODE_RED_STORAGE_PASSWORD=postgres

# --------------------------------------------------------------------------
# Ajustes opcionales de la conexion
# --------------------------------------------------------------------------
# Esquema de Postgres. Vacio = public.
NODE_RED_STORAGE_SCHEMA=

# TLS. Activalo con bases de datos gestionadas (Render, Neon, Supabase, Aiven).
NODE_RED_STORAGE_SSL=false
# Ponlo a false si el proveedor usa un certificado autofirmado.
NODE_RED_STORAGE_SSL_REJECT_UNAUTHORIZED=true

# Conexiones maximas del pool. Los planes gratuitos suelen limitar el numero de
# conexiones concurrentes: bajalo si ves errores de "too many connections".
NODE_RED_STORAGE_POOL_MAX=5

# Muestra las sentencias SQL en consola. Util para depurar, ruidoso en produccion.
NODE_RED_STORAGE_LOGGING=false

# --------------------------------------------------------------------------
# Contexto: batching y cache
# --------------------------------------------------------------------------
# 0 (por defecto) escribe de inmediato, asi que un valor es visible para todos
# los nodos, instancias y herramientas externas en cuanto se asigna. Subelo
# para agrupar escrituras a cambio de perder hasta N segundos ante un fallo.
NODE_RED_STORAGE_FLUSH_INTERVAL=0

# Cuanto tiempo puede servirse una lectura desde memoria antes de volver a
# consultar la base de datos. 0 (por defecto) lee siempre, de modo que los
# cambios externos se ven al instante.
NODE_RED_STORAGE_CACHE_TTL=0
